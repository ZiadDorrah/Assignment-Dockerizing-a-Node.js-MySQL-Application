# Copy this file to ".env" and fill in real values.
# This .env file will be referenced by your docker-compose.yml
# using the "env_file" or "environment" directive.

# --- Node app ---
PORT=3000

# --- MySQL connection (used by the Node app) ---
# DB_HOST must match the SERVICE NAME of the mysql container
# in your docker-compose.yml (Docker's internal DNS resolves
# service names automatically on a shared network).
DB_HOST=mysql
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=taskdb

# --- MySQL container itself (used by the mysql service) ---
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=taskdb
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
